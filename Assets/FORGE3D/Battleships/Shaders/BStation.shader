			CBUFFER_START(UnityPerMaterial)
			float4 _SpecularMap_ST;
			float4 _NormalMap_ST;
			float4 _Diffuse_ST;
			float4 _Tint;
			float4 _Emissive_ST;
			float4 _EmissiveColor;
			float _NormalScale;
			float _Shininess;
			float _EmissiveGlow;
			#ifdef TESSELLATION_ON
				float _TessPhongStrength;
